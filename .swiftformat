--swiftversion 6.0

# Keep `@testable import` in its own group below the plain imports, which is
# the style the test suite already uses.
--importgrouping testable-bottom

# SwiftLint's `trailing_comma` rule rejects trailing commas in collection
# literals, and SwiftFormat adds them by default. Turning them off here keeps
# the two tools from fighting over the same lines.
--trailing-commas never

--exclude Core/.build,.build
